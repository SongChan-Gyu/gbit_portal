generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// 조직
// ─────────────────────────────────────────
model Team {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  leaderId  String?    @unique
  leader    Employee?  @relation("TeamLeader", fields: [leaderId], references: [id])
  employees Employee[] @relation("TeamMembers")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ─────────────────────────────────────────
// 사원 마스터
// ─────────────────────────────────────────
model Employee {
  id           String       @id @default(cuid())
  empNo        String       @unique
  /// 회사 사번(로그인 ID). 내부 직원은 인사에서 입력 후 User.username과 동기화. 외부개발자 등은 null 가능.
  companyStaffNo String?    @unique
  name         String
  teamId       String?
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id])
  position     String
  dutyDept     String?       // 직급부서: OPERATIONS/EDUCATION/WELFARE → 귀속연도 초기화 시 2일 부여, NONE=해당사항없음
  employeeType String       @default("FULL")   // FULL / FREE
  hireDate     DateTime
  birthDate    DateTime?     // 생년월일 (생일반차쿠폰 등)
  phone        String   @default("")
  email        String?
  emailEnabled Boolean  @default(false) // 이메일 주소가 있으면 true로 저장(동기). 시스템 메일 차단용 아님.
  alimtalkEnabled Boolean @default(false) // 카카오 알림톡 사용 여부 (사원별). 기본 미사용.
  isSettingsAdmin Boolean @default(false) // 설정 메뉴(휴가설정·양식관리 등) 접근 허용 (결재선·역할 변경 없음)
  status       String       @default("PENDING") // PENDING/INVITED/ACTIVE/INACTIVE
  role         String       @default("STAFF")   // STAFF/TEAM_LEAD/PM/ADMIN

  user              User?
  inviteTokens      InviteToken[]
  leaveRequests     LeaveRequest[]
  leaveAllocations  LeaveAllocation[]
  stampCoupons      StampCoupon[]
  stampCards        StampCard[]
  stampRequests     StampRequest[]    @relation("StampRequester")
  stampApprovals    StampRequest[]    @relation("StampApprover")
  approvals         LeaveApproval[]
  auditLogs         AuditLog[]        @relation("AuditActor")
  teamLeaderOf      Team?             @relation("TeamLeader")
  notifications     Notification[]
  jejuAccommodations   JejuAccommodation[]
  jejuApprovedBy       JejuAccommodation[] @relation("JejuApprover")
  jejuStep1ApprovedBy  JejuAccommodation[] @relation("JejuStep1Approver")
  jejuDepositConfirmedBy JejuAccommodation[] @relation("JejuDepositConfirmer")
  notices           Notice[]

  improvementPosts       ImprovementPost[]       @relation("ImprovementPostAuthor")
  improvementComments  ImprovementComment[]
  improvementPostsClosed ImprovementPost[]      @relation("ImprovementPostClosedBy")
  supportTickets         SupportTicket[]         @relation("SupportTicketRequester")
  supportTicketMessages  SupportTicketMessage[]
  employeeGroupMembers       EmployeeGroupMember[]
  loginAnnouncementsAuthored LoginAnnouncement[]       @relation("LoginAnnouncementAuthor")
  loginAnnouncementDismissals LoginAnnouncementDismiss[]
  userFeatureTours           UserFeatureTour[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// ─────────────────────────────────────────
// 사용자 계정
// ─────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  employeeId   String    @unique
  employee     Employee  @relation(fields: [employeeId], references: [id])
  username     String    @unique
  passwordHash String
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordResetTokens PasswordResetToken[]
}

// ─────────────────────────────────────────
// 비밀번호 재설정 토큰 (비밀번호 찾기 링크용, 1시간 유효)
// ─────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

// ─────────────────────────────────────────
// 초대 토큰
// ─────────────────────────────────────────
model InviteToken {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────
// 휴가 유형 마스터 (메타데이터)
// ─────────────────────────────────────────
model LeaveType {
  id               String  @id @default(cuid())
  code             String  @unique
  name             String
  daysPerUnit      Float   @default(1)
  // 연차 잔여에서 차감 여부 (false = 경조/돌봄/공가/인정 등)
  deductFromBalance Boolean @default(true)
  // 결재 단계: 1=팀장만, 2=PM까지
  approvalSteps    Int     @default(2)
  // 월 최대 사용 횟수 (하프데이=1)
  maxPerMonth      Float?
  // 연간 최대 사용일 (null=무제한)
  maxPerYear       Float?
  // 스탬프 필요 여부
  requiresStamp    Boolean @default(false)
  stampCount       Int?
  // 전용 부여 풀: LeaveAllocation.sourceCode와 동일하면 신청 시 해당 풀에서만 차감 (null = 연차/스탬프/무제한 등 기존 규칙)
  allocationSourceCode String?
  // 신청/내역 화면 분류: 자산형(부여·차감 관리) / 사유형(승인일수 집계 중심)
  usageCategory    String  @default("ASSET") // ASSET | REASON
  // 같은 날 중복 허용 (오전반차+오후인정 등)
  allowSameDay     Boolean @default(true)
  // 신청 방식: 종일(기간) / 반차(오전·오후) 허용 범위 (관리자 설정). 둘 다 true면 신청 시 종일·오전·오후 선택.
  allowsFullDay    Boolean @default(true)
  allowsHalfDay    Boolean @default(false)
  // 반차만 허용할 때: 오전만 / 오후만 / 둘 다 (BOTH). 종일+반차 동시 허용이면 BOTH로 오전·오후 택일.
  halfDayAmPm      String  @default("BOTH") // BOTH | AM_ONLY | PM_ONLY
  // 휴가 신청 화면 카테고리 키 (annual, care …). null이면 "기타"
  applyGroupKey    String?
  // 신청 화면 카드 설명 문구 (예: 연 2일 한도, 별도 부여 등)
  displayHint      String?
  // 귀속연도 초기화(fiscal-year init) 대상 여부. 귀속연도 유형이어도 false면 자동 부여 제외.
  includeInFiscalInit Boolean @default(true)
  // 생일·입사주년 등: 귀속 초기화 시 스케줄러와 같이 '부여 기준일(KST)이 오늘 이전·당일'인 것만 보강. false면 FY 구간 내 미래 일정도 초기화에 포함(레거시).
  fiscalInitOnlyAfterGrantDate Boolean @default(true)
  // 입사 N주년에 부여 (입사일기준·allocationSourceCode 있을 때). 스케줄러·초기화 보강이 이 값을 사용.
  hireAnniversaryYears Int?
  // 관리자 수동 이월(다음 귀속연도 CARRYOVER 생성) UI 허용. 귀속연도형·자산형 연차 등만 true 권장. 자동 이월 없음.
  carryoverEligible Boolean @default(false)
  // 반차 여부 (AM or PM 선택) — 기존 데이터·간편 조회용. allows* 로부터 저장 시 동기화 권장.
  isHalf           Boolean @default(false)
  isAmOnly         Boolean @default(false)
  isPmOnly         Boolean @default(false)
  // 사용 가능 기간 기준: FISCAL=귀속연도, HIRE=입사일기준, GRANT=부여일기준
  validityBasis    String  @default("FISCAL")
  // 유효기간 (개월 수, null=귀속연도 끝까지)
  validityMonths   Int?
  // 반차·시간 단위 슬롯 정책 (예: TYPE_DEFAULT, HALF_ONLY 등 - 확장 예약 필드)
  slotPolicy       String  @default("TYPE_DEFAULT")
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)
  color            String  @default("#3b82f6") // 캘린더 색상
  // DB 실제 컬럼 (마이그레이션 20260425132000/140500)
  allowedWeekdays  String? // JSON: ["MON","TUE",...] null=제한없음
  deductMode       String  @default("STANDARD")  // STANDARD | MANUAL
  monthlyQuotaKey  String? // 월 사용 쿼터 그룹 키 (null=제한없음)
  requestFlow      String  @default("STANDARD")  // STANDARD | AUTO_APPROVE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requestItems  LeaveRequestItem[]
}

// ─────────────────────────────────────────
// 휴가 할당 (부여 단위 - 각 종류별 별도 관리)
// 예: 기본연차 15일, 5년근속 5일(유효기간 별도), 부서추가 2일 등
// ─────────────────────────────────────────
model LeaveAllocation {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  // 할당 분류: BASE_ANNUAL/TENURE_BONUS/DEPT_BONUS/TENURE_1Y/TENURE_5Y/TENURE_10Y/AWARD/CARRYOVER/SICK_RECOGNITION
  sourceCode  String
  label       String    // 표시명 (기본연차 15일, 5년근속 5일 등)
  totalDays   Float
  usedDays    Float     @default(0)
  validFrom   DateTime
  validUntil  DateTime
  fiscalYear  Int?      // 귀속연도 기준이면 기입. null=5년/10년 근속 등 귀속년도 없음 (MySQL PK 아님, NULL 허용)
  note        String?
  grantedById String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  usages     LeaveRequestItem[]

  @@index([employeeId, fiscalYear])
  @@index([employeeId, validUntil])
}

// ─────────────────────────────────────────
// 휴가 신청 (헤더)
// ─────────────────────────────────────────
model LeaveRequest {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  // 날짜 (같은 날 다중 유형이면 startDate=endDate)
  startDate    DateTime
  endDate      DateTime
  totalDays    Float                          // 전체 합산 일수
  reason       String?
  status       String    @default("PENDING")  // PENDING/APPROVED/REJECTED/CANCELLED/WITHDRAWN (+ CANCEL_REQUESTED)
  currentStep  Int       @default(1)
  totalSteps   Int       @default(2)
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        LeaveRequestItem[]
  approvals    LeaveApproval[]
  histories    LeaveHistory[]
}

// ─────────────────────────────────────────
// 휴가 신청 항목 (같은 날 여러 유형 지원)
// ─────────────────────────────────────────
model LeaveRequestItem {
  id             String           @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest     @relation(fields: [leaveRequestId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType        @relation(fields: [leaveTypeId], references: [id])
  allocationId   String?
  allocation     LeaveAllocation? @relation(fields: [allocationId], references: [id])
  days           Float
  startDate      DateTime
  endDate        DateTime
  // FULL | AM | PM — 유형이 종일+반차 겸용이거나 항목별 구분 필요 시
  timeSlot       String?
  reason         String?          // 항목별 사유
  createdAt      DateTime         @default(now())
}

// ─────────────────────────────────────────
// 결재
// ─────────────────────────────────────────
model LeaveApproval {
  id             String       @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  approverId     String
  approver       Employee     @relation(fields: [approverId], references: [id])
  step           Int
  status         String       @default("PENDING")
  comment        String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
}

// ─────────────────────────────────────────
// 휴가 이력
// ─────────────────────────────────────────
model LeaveHistory {
  id             String       @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  action         String
  actorId        String?
  comment        String?
  snapshot       String?
  createdAt      DateTime     @default(now())
}

// ─────────────────────────────────────────
// 스탬프 요청 (팀장 서명 승인)
// ─────────────────────────────────────────
model StampRequest {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation("StampRequester", fields: [employeeId], references: [id])
  stampDate   DateTime
  description String
  status      String    @default("PENDING")  // PENDING/APPROVED/REJECTED
  approverId  String?
  approver    Employee? @relation("StampApprover", fields: [approverId], references: [id])
  approvedAt  DateTime?
  comment     String?
  stampId     String?   // 승인 후 생성된 StampCoupon.id
  createdAt   DateTime  @default(now())

  @@index([employeeId])
}

// ─────────────────────────────────────────
// 스탬프 장(10칸): 칸마다 StampCoupon 1개. 힐링·오후인정 권한은 장 단위(소모해도 ★은 유지).
// ─────────────────────────────────────────
model StampCard {
  id                      String        @id @default(cuid())
  employeeId              String
  employee                Employee      @relation(fields: [employeeId], references: [id])
  sortOrder               Int           // 적립 순서 (오래된 장부터 권한 탐색)
  filledCount             Int           @default(0) // 1~10, 해당 장에 찍힌 스탬프 수
  healingUsed             Boolean       @default(false)
  afternoonUsed           Boolean       @default(false)
  healingLeaveRequestId   String?
  afternoonLeaveRequestId String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  stamps                  StampCoupon[]

  @@index([employeeId])
  @@index([healingLeaveRequestId])
  @@index([afternoonLeaveRequestId])
}

// ─────────────────────────────────────────
// 스탬프 쿠폰 (1칸 = 1행, 표시용)
// ─────────────────────────────────────────
model StampCoupon {
  id             String     @id @default(cuid())
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id])
  stampCardId    String?
  stampCard      StampCard? @relation(fields: [stampCardId], references: [id], onDelete: SetNull)
  stampDate      DateTime
  isUsed         Boolean    @default(false)
  usedForType    String?
  usedAt         DateTime?
  usedRequestId  String?
  createdAt      DateTime   @default(now())

  @@index([stampCardId])
}

// ─────────────────────────────────────────
// 공휴일 캘린더
// ─────────────────────────────────────────
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  isHalfDay Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
// 테스트 우회 로그인 (개발용)
// ─────────────────────────────────────────
model TestBypass {
  id         String    @id @default(cuid())
  employeeId String
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────
// 귀속연도 자동 부여 구분 (휴가관리에서 추가/제거 용이)
// ─────────────────────────────────────────
model AllocationSourceConfig {
  id          String   @id @default(cuid())
  sourceCode  String   @unique  // BASE_ANNUAL, TENURE_BONUS, CARE, HOLIDAY_EXT, DUTY_DEPT 등
  label       String   // 표시명
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  defaultDays Float?   // 고정 부여일 수 (CARE=2, HOLIDAY_EXT=1, BASE_ANNUAL=15 등)

  // 근속 기념일 기반 특별 부여 (TENURE_1Y/5Y/10Y)
  // tenureYears가 설정된 sourceCode는 해당 입사 N주년에 스케줄러가 자동 부여한다.
  tenureYears      Int?   // 기념일 연수 (1, 5, 10 등). null이면 기념일 기반 아님.
  // 귀속연도 말미 N개월 이내 부여분을 다음 귀속연도로 이월하는 임계값
  carryoverThresholdMonths Int? // 이월 임계 개월수 (TENURE_1Y=3: 귀속연도 마지막 3개월 부여 시 자동 이월)

  // 근속 가산 규칙 (TENURE_BONUS)
  // bonusIntervalYears/bonusMaxDays가 설정되면 귀속연도 초기화 시 공식 계산
  bonusIntervalYears Int?   // 가산 기준 연수 (2 = 2년마다 +1일). null이면 가산 없음.
  bonusMaxDays    Float?   // 가산 최대 일수 (10일). null이면 무제한.
  skipForFreelancer Boolean @default(false) // true면 FREE(프리랜서) 사원 제외
  // tenureYears 기반 근속 마일스톤: 귀속 초기화 시 기념일이 KST 오늘 이후면 제외할지(LeaveType.fiscalInitOnlyAfterGrantDate와 동일 의미)
  fiscalInitOnlyAfterGrantDate Boolean @default(true)
  // DB 실제 컬럼 (마이그레이션 20260425132000)
  isAnnualPool Boolean @default(false) // true이면 연차 풀로 취급

  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────
// 스케줄러 유형 (유형별 조회·관리용 기준데이터)
// ─────────────────────────────────────────
model SchedulerJobType {
  id          String   @id @default(cuid())
  jobKey      String   @unique  // monthly_accrual, tenure_check, birthday_half
  name        String   // 표시명
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────
// 시스템 설정 (메뉴권한 JSON 등)
// ─────────────────────────────────────────
model SystemConfig {
  key       String   @id
  value     String   // JSON
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
// 알림 로그
// ─────────────────────────────────────────
model NotificationLog {
  id           String   @id @default(cuid())
  targetId     String
  phone        String
  type         String
  templateCode String
  params       String?
  status       String   @default("PENDING")
  errorMsg     String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────
// 감사 로그
// ─────────────────────────────────────────
model AuditLog {
  id         String    @id @default(cuid())
  entityType String    // LeaveRequest / LeaveAllocation / Employee / Scheduler / System
  entityId   String
  action     String    // CREATED / UPDATED / DELETED / APPROVED / REJECTED / CANCELLED / RESTORED
  actorId    String?
  actor      Employee? @relation("AuditActor", fields: [actorId], references: [id])
  actorName  String?   // actorId 없는 경우(시스템 자동) 표시명
  before     String?   @db.Text // JSON 변경 전 (긴 페이로드 허용)
  after      String?   @db.Text // JSON 변경 후
  note       String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────
// 알림
// ─────────────────────────────────────────
model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String   // LEAVE_REQUEST / LEAVE_APPROVED / LEAVE_REJECTED / LEAVE_CANCEL / STAMP_REQUEST / STAMP_APPROVED / STAMP_REJECTED
  title      String
  body       String
  isRead     Boolean  @default(false)
  link       String?
  createdAt  DateTime @default(now())

  @@index([employeeId, isRead])
  @@index([employeeId, createdAt])
}

// ─────────────────────────────────────────
// 제주도 숙소 신청 (복지부 승인, 주말 포함 가능, 1박 이상)
// ─────────────────────────────────────────
model JejuAccommodation {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  startDate     DateTime
  endDate       DateTime
  nights        Int       // 1 이상 (입실일 15시 ~ 퇴실일 11시, 박 단위)
  reason        String?
  // 필수 입력: 이름·연락처·입실인원
  guestName     String
  guestPhone    String
  guestCount    Int       // 입실 인원
  depositorName String    // 입금자명 (예약금 무통장입금 시 예약자가 입력)

  // ── 2단계 결재 상태 ──────────────────────────────────
  // PENDING: 신청 완료, 복지부 승인 대기
  // STEP1_APPROVED: 복지부 승인 완료, PM 입금확인 대기
  // APPROVED: 입금확인 완료 (전체 승인)
  // REJECTED: 반려
  // CANCELLED: 취소 완료
  // CANCEL_REQUESTED: 취소 요청 (1차 취소 승인 대기)
  // CANCEL_STEP1_APPROVED: 취소에 대한 복지부 승인 완료, PM 입금취소 대기
  status        String    @default("PENDING")

  // 복지부 승인
  step1ApproverId  String?
  step1Approver    Employee? @relation("JejuStep1Approver", fields: [step1ApproverId], references: [id])
  step1ApprovedAt  DateTime?
  rejectStep       Int?      // 반려 발생 단계 (1 or 2)

  // 2차 결재 (PM 입금 확인) — approvedById/approvedAt 재사용
  approvedById  String?
  approvedBy    Employee? @relation("JejuApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?

  // 입금 상태: NONE / CONFIRMED / CANCELLED
  depositStatus          String    @default("NONE")
  depositConfirmedById   String?
  depositConfirmedBy     Employee? @relation("JejuDepositConfirmer", fields: [depositConfirmedById], references: [id])
  depositConfirmedAt     DateTime?

  rejectComment String?
  cancelledAt   DateTime?
  cancelReason  String?
  cancelRequestedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

// ─────────────────────────────────────────
// 유동 양식 (건강검진 신청 등 - 비회원도 링크로 제출 가능)
// ─────────────────────────────────────────
model Form {
  id          String    @id @default(cuid())
  title       String    // e.g. "건강검진 신청"
  slug        String?   @unique  // URL용: health-check-2025 (없으면 공개 링크 미사용)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  // 포털 메뉴 노출 설정
  showInMenu  Boolean   @default(false)
  audience    String    @default("ALL")  // ALL | INTERNAL | EXTERNAL | GROUP
  /// audience=GROUP 일 때만 사용
  employeeGroupId String?       @map("targetGroupId")
  employeeGroup   EmployeeGroup? @relation(fields: [employeeGroupId], references: [id], onDelete: SetNull)
  /// true면 제출 목록·내보내기에서 제출자를 '익명'으로 표시 (1인 1표·직원 연결은 DB에 유지)
  isAnonymous Boolean   @default(false)
  /// 제출 유효기간 (알림톡·관리 안내용, null이면 별도 공지)
  submitDeadline DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fields      FormField[]
  submissions FormSubmission[]
}

/// 직원 그룹 (유동양식·공지·로그인 팝업 대상 공통)
model EmployeeGroup {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             EmployeeGroupMember[]
  forms               Form[]
  notices             Notice[]
  loginAnnouncements  LoginAnnouncement[]

  @@index([sortOrder])
  @@map("FormTargetGroup")
}

model EmployeeGroupMember {
  id         String        @id @default(cuid())
  groupId    String
  group      EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([groupId, employeeId])
  @@index([employeeId])
  @@map("FormTargetGroupMember")
}

model FormField {
  id        String  @id @default(cuid())
  formId    String
  form      Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  label     String  // 질문/필드명
  fieldType String  @default("text")  // text | select
  options   String? @db.Text  // select일 때 JSON 배열 e.g. ["본인","가족"]
  required  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers FormSubmissionAnswer[]

  @@index([formId])
}

model FormSubmission {
  id            String    @id @default(cuid())
  formId        String
  form          Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  submitterName String    @default("")  // 제출자 이름 (세션 or 빈 문자열)
  submitterEmail String?  @default("")
  submitterPhone String?  @default("")
  employeeId    String?   // 로그인 제출 시 연결
  createdAt     DateTime  @default(now())

  answers FormSubmissionAnswer[]

  @@index([formId])
  @@index([formId, createdAt])
}

model FormSubmissionAnswer {
  id             String         @id @default(cuid())
  formSubmissionId String
  formSubmission   FormSubmission @relation(fields: [formSubmissionId], references: [id], onDelete: Cascade)
  formFieldId      String
  formField        FormField     @relation(fields: [formFieldId], references: [id], onDelete: Cascade)
  value            String        @db.Text
  createdAt        DateTime      @default(now())

  @@unique([formSubmissionId, formFieldId])
  @@index([formSubmissionId])
  @@index([formFieldId])
}

// ─────────────────────────────────────────
// 공지사항 (PM/ADMIN만 작성, 리치 텍스트, 댓글 없음)
// ─────────────────────────────────────────
model Notice {
  id              String   @id @default(cuid())
  title           String
  content         String   @db.LongText  // HTML
  audience        String   @default("ALL") // ALL | INTERNAL | EXTERNAL | GROUP
  employeeGroupId String?
  employeeGroup   EmployeeGroup? @relation(fields: [employeeGroupId], references: [id], onDelete: SetNull)
  authorId        String
  author          Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  loginAnnouncements LoginAnnouncement[]

  @@index([createdAt])
  @@index([audience])
}

/// 로그인 후 노출 공지 팝업
model LoginAnnouncement {
  id              String    @id @default(cuid())
  title           String
  body            String    @db.Text
  audience        String    @default("INTERNAL")
  employeeGroupId String?
  employeeGroup   EmployeeGroup? @relation(fields: [employeeGroupId], references: [id], onDelete: SetNull)
  startsAt        DateTime?
  endsAt          DateTime?
  priority        Int       @default(0)
  detailMode      String    @default("NONE") // NONE | NOTICE
  noticeId        String?
  notice          Notice?   @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  isActive        Boolean   @default(true)
  authorId        String
  author          Employee  @relation("LoginAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  dismissals      LoginAnnouncementDismiss[]

  @@index([isActive, priority])
  @@index([startsAt, endsAt])
}

model LoginAnnouncementDismiss {
  id             String            @id @default(cuid())
  announcementId String
  announcement   LoginAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dismissType    String            // CLOSE | WEEK
  dismissedUntil DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([announcementId, employeeId])
  @@index([employeeId])
}

/// 화면별 최초 1회 기능 안내 (POC: leave_apply)
model UserFeatureTour {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tourKey     String
  completedAt DateTime?
  skippedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([employeeId, tourKey])
  @@index([tourKey])
}

// ─────────────────────────────────────────
// 내부 직원 전용: 개선·협의 게시판 (댓글·대댓글, 종료)
// ─────────────────────────────────────────
model ImprovementPost {
  id         String    @id @default(cuid())
  authorId   String
  author     Employee  @relation("ImprovementPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String    @db.Text
  status     String    @default("OPEN") // OPEN | CLOSED
  closedAt   DateTime?
  closedById String?
  closedBy   Employee? @relation("ImprovementPostClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  comments   ImprovementComment[]

  @@index([status, updatedAt])
  @@index([authorId])
}

model ImprovementComment {
  id        String   @id @default(cuid())
  postId    String
  post      ImprovementPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ImprovementComment?  @relation("ImprovementThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ImprovementComment[] @relation("ImprovementThread")
  authorId  String
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([parentId])
}

// ─────────────────────────────────────────
// 내부 직원 전용: 1:1 문의 티켓
// ─────────────────────────────────────────
model SupportTicket {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("SupportTicketRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  subject    String
  status     String   @default("OPEN") // OPEN | CLOSED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  messages   SupportTicketMessage[]

  @@index([employeeId, updatedAt])
  @@index([status])
}

model SupportTicketMessage {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId     String
  author       Employee      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String        @db.Text
  isStaffReply Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ─────────────────────────────────────────
// 스케줄러 실행 이력
// ─────────────────────────────────────────
model SchedulerLog {
  id          String   @id @default(cuid())
  jobName     String   // monthly_accrual / tenure_check
  targetParam String?  // 대상 월 또는 날짜
  isDryRun    Boolean  @default(false)
  status      String   @default("SUCCESS") // SUCCESS / PARTIAL / FAILED
  grantedCount Int     @default(0)
  skippedCount Int     @default(0)
  errorCount   Int     @default(0)
  detail       String? // JSON 상세 결과
  triggeredBy  String  @default("SYSTEM") // SYSTEM / ADMIN / MANUAL
  actorId      String?
  createdAt    DateTime @default(now())

  @@index([jobName, createdAt])
}
