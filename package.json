{
  "name": "hrm-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:local": "prisma generate && prisma migrate deploy && (npx prisma db seed || true) && next dev",
    "local:setup": "sh scripts/local-setup.sh",
    "build": "next build",
    "start": "next start",
    "start:prod": "sh scripts/start-prod.sh",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed-base.ts",
    "db:seed:base": "npx tsx prisma/seed-base.ts",
    "db:seed:dev": "npx tsx prisma/seed.ts",
    "reset:leave:test": "CONFIRM_WIPE=RESET_LEAVE npx tsx scripts/reset-leave-test-data.ts",
    "reset:leave:test:force": "FORCE_RESET_LEAVE_TEST_DATA=1 CONFIRM_WIPE=RESET_LEAVE npx tsx scripts/reset-leave-test-data.ts",
    "smoke:local": "npm run reset:leave:test && npm run verify:leave && npm run verify:data && npm run build",
    "verify:leave": "npx tsx scripts/verify-leave-policy.ts",
    "verify:data": "npx tsx scripts/verify-data-integrity.ts",
    "wipe:preview": "KEEP_USERNAMES=admin,pm npx tsx scripts/production-wipe.ts",
    "wipe:go": "CONFIRM_WIPE=WIPE KEEP_USERNAMES=admin,pm npx tsx scripts/production-wipe.ts",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "cron": "node cron-runner.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.8.0",
    "@prisma/client": "^6.19.2",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^2.4.3",
    "isomorphic-dompurify": "^2.36.0",
    "lucide-react": "^0.575.0",
    "next": "^15.1.11",
    "next-auth": "^5.0.0-beta.25",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
    "postcss": "^8.5.6",
    "rate-limiter-flexible": "^10.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.4.1",
    "tsx": "^4.19.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed-base.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "^15.1.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^28.1.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
