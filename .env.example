# DB (로컬 MySQL: 반드시 127.0.0.1 사용. localhost 시 P1001 나올 수 있음)
DATABASE_URL="mysql://root:hrm_secret@127.0.0.1:3306/hrm_web"
#
# [Docker로 로컬 MySQL만 띄우기] 프로젝트 루트에서: npm run docker:up
# (Docker Desktop 필요, 비밀번호·DB명은 위 DATABASE_URL 과 docker-compose.yml 과 동일)

# Docker Compose에서 사용 (선택, 미설정 시 기본값 사용)
# MYSQL_ROOT_PASSWORD=hrm_secret
# MYSQL_DATABASE=hrm_web

# NextAuth (운영 시 필수 변경)
# NEXTAUTH_URL=https://your-domain.com
# NEXTAUTH_SECRET=랜덤_긴_시크릿
#
# [로컬에서 Cursor/IDE 내장 브라우저로 로그인 안 될 때]
# 웹뷰는 세션 쿠키가 막히는 경우가 많음 → Chrome·Edge로 localhost 접속 권장.
# localhost와 127.0.0.1을 섞어 쓰면 쿠키·CSRF가 어긋날 수 있음 → 아래는 접속 주소와 동일하게 맞출 것.
# NEXTAUTH_URL=http://localhost:3000
#
# [배포 후 로그인이 안 될 때]
# 1. NEXTAUTH_URL이 배포 주소와 일치하는지 확인 (예: https://xxx.railway.app)
# 2. NEXTAUTH_SECRET이 한 번 설정 후 바뀌지 않았는지 확인 (바뀌면 기존 세션 무효)
# 3. 배포 환경 DB에 시드 실행 여부 확인 (User/Employee 없으면 로그인 불가)
#    - Railway: 서비스에서 "Run Command" 또는 일회성 컨테이너로 npx prisma db seed 실행
#    - 필요 시 scripts/seed-admin-once.ts 로 관리자 1명만 생성

# 제주도 숙소 정보 페이지 지도 (선택, 무료)
# Kakao Developers(developers.kakao.com) > 내 애플리케이션 > 앱 키 에서 "JavaScript 키" 복사
# 플랫폼 > Web에 사이트 도메인 정확히 등록 (예: https://gbitportal-production.up.railway.app, 끝에 / 없이). 무료 한도: 일 30만 건.
# NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=your_kakao_javascript_key
# 배포(Railway 등)에서 빌드 후에 env만 넣은 경우: /api/jeju/map-config 가 런타임에 키를 넘겨주므로, env 설정 후 서비스만 재시작하면 됨.

# ─── 이메일 발송 (SMTP) ─────────────────────────────────────────────
# 발송만 하므로 SMTP만 설정하면 됩니다. POP3는 수신용이라 사용하지 않습니다.
#
# [네이버 메일로 테스트]
# 1. 네이버 메일 > 환경설정 > POP3/SMTP 설정 > "사용함" 선택 후 저장
# 2. SMTP 서버: smtp.naver.com, 포트: 465 (SSL 필수)
# 3. 비밀번호: 로그인 비밀번호가 아니라 "애플리케이션 비밀번호" 사용
#    (네이버 계정 > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호 생성)
# 4. 테스트 발송은 실제 수신자 주소로 진행 (강제 덮어쓰기 옵션 없음)
#
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# SMTP_USER=네이버아이디
# SMTP_PASS=애플리케이션비밀번호
# SMTP_FROM=네이버아이디@naver.com
#
# ─── [운영 시 이메일] 클라우드(Railway 등) Variables에 그대로 추가 ───
# SMTP_HOST= (회사 메일 SMTP 서버, 예: smtp.gmail.com / smtp.office365.com / smtp.naver.com)
# SMTP_PORT=465
# SMTP_USER= (메일 계정 또는 발신 전용 계정)
# SMTP_PASS= (비밀번호 또는 앱 비밀번호)
# SMTP_FROM= (발신 표시 주소, 예: noreply@회사도메인.com)
# ─── 카카오 알림톡 — 다이렉트센드(DirectSend) (선택) ─────────────────────────
# 제주 담당자 알림을 이메일만 쓰면 아래 없이 운영 가능.
# 다이렉트센드에서 발신프로필·알림톡 템플릿 등록 후, 템플릿마다 user_template_no 를 JSON에 넣음.
# 코드 매핑·note1~5 의미: docs/alimtalk-templates.md
#
# DIRECTSEND_USERNAME=다이렉트센드_아이디
# DIRECTSEND_API_KEY=다이렉트센드_API_key
# DIRECTSEND_KAKAO_PLUS_ID=@검색용아이디
# DIRECTSEND_ALIMTALK_TEMPLATE_NOS={"LEAVE_REQUEST":"…","LEAVE_WITHDRAWN":"…","LEAVE_RESULT":"…","JEJU_APPLICANT_STEP1_OK":"…","JEJU_APPROVED":"…","JEJU_REJECTED":"…","JEJU_CANCELLED":"…","JEJU_STAFF":"…","JEJU_STAFF_CANCEL":"…"}
#
# 제주: 1차 승인 후 입금 미확인 일수 (스케줄러가 자동 취소, 신청자 알림톡은 발송하지 않음)
# JEJU_DEPOSIT_DEADLINE_DAYS=5
#
# [테스트] 특정 번호로만 발송 허용 — 그 외 SKIPPED
# ALIMTALK_ALLOWED_RECEIVER=01044234532
#
# 휴가 신청 철회(승인 전) 결재자 알림톡 on/off·범위 (기존과 동일)
# LEAVE_WITHDRAW_ALIMTALK=1
# LEAVE_WITHDRAW_ALIMTALK_SCOPE=pending
#
# ─── 요청(접속) 로그 (선택) ─────────────────────────────────────────────
# 설정 시 API 요청마다 IP·메서드·URL이 RequestLog 테이블에 기록됩니다. (관리 > 시스템 설정 > 데이터에서 "요청(접속) 로그" 테이블로 조회)
# 미설정 시 로그 비기록. 운영/보안 확인용.
# REQUEST_LOG_SECRET=랜덤_시크릿_문자열
#
# ─── 테스트 우회 로그인 (사용자 전환) ─────────────────────────────
# true 설정 시 사용자 전환(/test/user-switch) 기능 비활성화. 미설정 시 프로덕션에서도 사용 가능(테스트 단계용).
# 정식 오픈 후 보안을 위해 RESTRICT_TEST_BYPASS=true 로 제한 권장.
# RESTRICT_TEST_BYPASS=true
#
# ─── 서버 타임존 TZ (선택) ─────────────────────────────────────────────────
# 휴가·제주의 날짜(YYYY-MM-DD)·영업일·귀속연도 등은 src/lib/dateUtils · workdays 에서 KST(Asia/Seoul) 기준으로 계산합니다.
# DB에 UTC로 저장되어도 위 로직과 맞게 동작하도록 설계되어 있어, 클라우드에서 TZ 미설정이어도 날짜 비즈니스 로직은 대체로 문제 없습니다.
# 서버 로그 시각 정렬·일부 raw Date 사용 구간·외부 cron과 맞출 때는 TZ=Asia/Seoul 권장.
# Railway 등: 필요 시 Variables에 TZ=Asia/Seoul
# TZ=Asia/Seoul

# ─── 스케줄러 (월별 연차 발생, 근속 체크 등) ─────────────────────────────
# Next.js 앱과 별도로 cron-runner.mjs 를 실행해야 합니다. 클라우드에서는 같은 프로젝트를 두 서비스로 띄우거나,
# 외부 cron 서비스에서 매일 해당 API를 호출하는 방식으로 사용하세요.
# CRON_SECRET=랜덤_시크릿 (API 호출 시 Header x-cron-secret 에 넣어 인증)
# NEXT_PUBLIC_APP_URL=https://your-domain.com (cron-runner가 호출할 앱 주소)
